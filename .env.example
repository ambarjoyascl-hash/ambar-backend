# ─────────────────────────────────────────────────────────
# VARIABLES DE ENTORNO — Ambar Joyas Backend
# Configura estas variables en el panel de Vercel.
# ─────────────────────────────────────────────────────────

# MercadoPago ─────────────────────────────────────────────
# Obtenlas en https://www.mercadopago.cl/developers/panel
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxx
MP_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Resend (emails) ─────────────────────────────────────────
# Obtenla en https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shopify ─────────────────────────────────────────────────
# Se obtiene al crear el webhook en Shopify Admin
# Admin → Configuracion → Notificaciones → Webhooks
SHOPIFY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Contacto ────────────────────────────────────────────────
# Email donde recibes las notificaciones de nuevos pedidos
OWNER_EMAIL=hola@ambarjoyas.cl

# Sitio web ───────────────────────────────────────────────
SITE_URL=https://www.ambarjoyas.cl
